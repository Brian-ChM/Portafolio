---
import { skillAreas } from "../data/profile";
---

<section class="trace-skills" id="skills" aria-labelledby="skills-title">
  <div class="trace-section-heading">
    <h2 id="skills-title">
      Habilidades
      <br />
      técnicas.
    </h2>
    <p>
      Herramientas y conocimientos,
      <br />
      con el contexto en el que los uso.
    </p>
  </div>
  <div class="trace-skill-matrix">
    {skillAreas.map((area) => (
      <article class="trace-skill-area">
        <h3>{area.title}</h3>
        <div>
          <ul class="trace-tool-list" aria-label={area.title}>
            {area.tools.map((tool) => (
              <li translate="no">{tool}</li>
            ))}
          </ul>
          <p>{area.context}</p>
        </div>
      </article>
    ))}
  </div>
</section>
