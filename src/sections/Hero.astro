---
import HeroWiring from "../components/HeroWiring.astro";
import Icon from "../components/Icon.astro";
import { profile } from "../data/profile";
---

<section class="trace-cover" id="intro" aria-labelledby="intro-title">
  <div class="trace-cover-heading">
    <div class="trace-identity">
      <p class="trace-role">{profile.role}</p>
      <h1 id="intro-title" translate="no">
        Brian
        <br />
        Chaparro
      </h1>
    </div>
    <div class="trace-intro">
      <span class="trace-intro-rule" aria-hidden="true"></span>
      <h2>
        Backend, integraciones
        <br />y despliegues.
      </h2>
      <p>
        Desarrollo aplicaciones empresariales, desde el backend y las
        integraciones hasta las interfaces y las pruebas. Experiencia en
        despliegues y entornos de servidores.
      </p>
      <div class="hero-actions">
        <a class="hero-action hero-action-primary" href="#experience">
          Ver experiencia <Icon name="arrow-down-right" />
        </a>
        <a
          class="hero-action hero-action-secondary"
          href={profile.cv}
          download="Brian_Chaparro_CV.pdf"
          type="application/pdf"
        >
          Descargar CV <Icon name="download" />
        </a>
      </div>
    </div>
  </div>
  <HeroWiring />
  <div class="trace-cover-foot">
    <span>C# / .NET</span>
    <span>APIs e integraciones</span>
    <span>Docker / Kubernetes</span>
    <span class="trace-foot-location">{profile.location}</span>
  </div>
</section>
