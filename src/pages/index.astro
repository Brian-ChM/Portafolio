---
import Navbar from "../components/Navbar.astro";
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import Contact from "../sections/Contact.astro";
import Experience from "../sections/Experience.astro";
import Hero from "../sections/Hero.astro";
import Skills from "../sections/Skills.astro";
import { profile } from "../data/profile";
---

<Layout title="Brian Chaparro | Backend, integraciones y despliegues">
  <Navbar />
  <main id="main-content" tabindex="-1">
    <Hero />
    <Experience />
    <Skills />
    <Contact />
  </main>
  <footer class="site-footer">
    <span>
      {profile.name}
      <span class="footer-location">{profile.location}</span>
    </span>
    <a href="#intro">
      Volver al inicio <Icon name="arrow-up" />
    </a>
  </footer>
</Layout>
